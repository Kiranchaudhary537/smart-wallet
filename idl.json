            "name": "delegate",
            "type": "pubkey"
          },
          {
            "name": "mint",
            "type": "pubkey"
          },
          {
            "name": "allowed_recipient",
            "docs": [
              "Pubkey::default() = any recipient. For tokens this is compared with the",
              "destination token account's *owner*."
            ],
            "type": "pubkey"
          },
          {
            "name": "limit_per_period",
            "docs": [
              "Max amount (lamports or token base units) per window."
