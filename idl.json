            "name": "paused",
            "type": "bool"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "Delegate",
      "docs": [
        "A scoped permission for one delegate on one asset.",
        "PDA: [\"delegate\", wallet, delegate, mint]  (mint = SOL_MINT for native SOL)"
